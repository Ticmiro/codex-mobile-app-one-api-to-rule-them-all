TICMIRO_SERVER_URL=https://codex.example.com
TICMIRO_AGENT_TOKEN=replace-with-windows-bridge-token
TICMIRO_BRIDGE_ID=windows-pc

CODEX_HOME=C:\Users\YourName\.codex
TICPROXY_BASE_URL=https://codex.example.com/v1
TICPROXY_API_KEY=replace-with-user-facing-proxy-key
# Optional if codex is not in PATH. Use the real detected version folder.
# TICMIRO_CODEX_BIN=C:\Users\YourName\AppData\Local\OpenAI\Codex\bin\<version>\codex.exe

TICMIRO_ALLOWED_ROOTS=C:\Users\YourName\Documents;C:\Users\YourName\Desktop
TICMIRO_LOCAL_ATTACHMENTS_DIR=C:\Users\YourName\AppData\Local\Ticmiro\CodexMobile\attachments

# Windows defaults to per-command because it is currently more stable across Codex Desktop builds.
# Set managed only when testing long-lived app-server host mode.
TICMIRO_CODEX_APP_SERVER_MODE=per-command
TICMIRO_THREAD_SNAPSHOT_WAIT_MS=15000
TICMIRO_THREAD_PROGRESS_SNAPSHOT_MS=3000

# Optional: use when the bridge cannot auto-discover the Desktop launcher.
# TICMIRO_CODEX_DESKTOP_BIN=C:\Users\YourName\AppData\Local\Programs\Codex\Codex.exe
# TICMIRO_CODEX_DESKTOP_RESTART_COMMAND=Stop-Process -Name Codex -Force; Start-Process "C:\Path\To\Codex.exe"
# TICMIRO_CODEX_DESKTOP_RESTART_TIMEOUT_MS=30000
