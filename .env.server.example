TICMIRO_PORT=4899
TICMIRO_HOST=0.0.0.0
TICMIRO_PUBLIC_BASE_URL=https://codex.example.com
TICMIRO_DATA_DIR=/app/data

# Mobile UI token, Windows bridge token, and admin token should all differ in production.
TICMIRO_MOBILE_TOKEN=replace-with-mobile-token
TICMIRO_AGENT_TOKEN=replace-with-windows-bridge-token
TICMIRO_ADMIN_TOKEN=replace-with-admin-token

# API keys accepted by /v1/* proxy endpoints. These are the keys Codex clients use.
TICMIRO_PROXY_API_KEYS=replace-with-user-facing-proxy-key

# Optional Auther controls.
TICMIRO_TOKEN_REFRESH_SKEW_SECONDS=180
TICMIRO_PROXY_KEY_DAILY_REQUEST_LIMIT=0
TICMIRO_PROXY_KEY_DAILY_TOKEN_LIMIT=0

# Optional: inline provider config JSON. Prefer mounted /app/data/providers.json in production.
TICMIRO_PROVIDER_CONFIG_JSON=

# Optional Zalo Link bridge. Runtime cookies stay under TICMIRO_DATA_DIR and are gitignored.
ZALO_BRIDGE_AUTO_START=1
ZALO_BRIDGE_DEBUG=0
ZALO_BRIDGE_USER_AGENT=
